// Copy this file to Secrets.xcconfig (already in .gitignore) and fill in the key.
// In Xcode: select the BinSight project → Info tab → set the Configurations'
// "Based on Configuration File" to BinSight/Secrets for both Debug and Release.
//
// Or pass at build time:
//   xcodebuild ... PERPLEXITY_API_KEY=pplx-yourkey
PERPLEXITY_API_KEY = pplx-replaceme
